# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Model pinned for reproducibility (see registrations/01-hypothesis.md)
SETDRIFT_MODEL=claude-sonnet-4-6
# Where telemetry is written (MUST stay under data/ — the gitignored wall)
SETDRIFT_TELEMETRY_PATH=data/telemetry/events.jsonl

# ---------------------------------------------------------------------------
# LLM backend selection (eval harness only)
# ---------------------------------------------------------------------------
# Selects the transport used by setdrift_eval.benchmark.llm_backend.call_model.
#   anthropic  — Anthropic Messages API (default; behavior byte-identical to t=0 baseline)
#   openrouter — OpenAI Chat-Completions wire format via OpenRouter, provider-locked
#                to first-party Anthropic (see SETDRIFT_OPENROUTER_PROVIDER below)
SETDRIFT_LLM_BACKEND=anthropic

# Required when SETDRIFT_LLM_BACKEND=openrouter
OPENROUTER_API_KEY=sk-or-xxxxxxxx

# When using OpenRouter, SETDRIFT_MODEL must use dot notation for the model version:
#   anthropic/claude-sonnet-4.6   (primary model)
#   anthropic/claude-haiku-4.5    (sensitivity arm)
# Example: SETDRIFT_MODEL=anthropic/claude-sonnet-4.6

# Optional OpenRouter provider-lock overrides (defaults shown):
# SETDRIFT_OPENROUTER_PROVIDER=["Anthropic"]        # JSON list; locks to first-party Anthropic routing
# SETDRIFT_OPENROUTER_ALLOW_FALLBACKS=false         # never fall back to non-Anthropic providers
