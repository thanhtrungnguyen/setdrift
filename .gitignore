# ---- THE DATA WALL: proprietary / captured data never enters git ----
# Everything under data/ is ignored EXCEPT the explanatory README.
data/**
!data/README.md
# The eval harness writes mined corpus + raw captures under eval/data/ (a
# nested location, NOT top-level data/). Same wall, anchored to eval/.
eval/data/**
!eval/data/README.md
# Any captured telemetry DATA, logs, replays, mined repos.
# NOTE: scope to data dirs only — `**/telemetry/**` was too broad and also
# excluded the SOURCE package eval/sica_eval/telemetry/ (scrubber/parser/query
# code + tests). Telemetry DATA lives under data/ (covered by data/** above and
# eval/data/** ); the source package must stay tracked.
data/telemetry/**
*.jsonl
*.sqlite
*.sqlite3
*.db
mined_repos/
replays/
parking_src/
*.parking.*

# ---- Secrets ----
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.yaml

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node (plugin tooling, if any) ----
node_modules/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
